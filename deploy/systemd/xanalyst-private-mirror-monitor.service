[Unit]
Description=xanalyst Private Mirror Monitor (Telethon ingester)
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/xanalyst
EnvironmentFile=/opt/xanalyst/.env
ExecStart=/opt/xanalyst/venv/bin/python -m services.private_mirror_monitor
Restart=on-failure
RestartSec=10
MemoryMax=150M
StandardOutput=append:/opt/xanalyst/logs/private_mirror_monitor.log
StandardError=append:/opt/xanalyst/logs/private_mirror_monitor.log

[Install]
WantedBy=multi-user.target
