[Unit]
Description=xanalyst CatchMint Mint Radar (NFT burst detector)
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/xanalyst
EnvironmentFile=/opt/xanalyst/.env
ExecStart=/opt/xanalyst/venv/bin/python -m services.catchmint_radar
Restart=on-failure
RestartSec=10
MemoryMax=150M
StandardOutput=append:/opt/xanalyst/logs/catchmint_radar.log
StandardError=append:/opt/xanalyst/logs/catchmint_radar.log

[Install]
WantedBy=multi-user.target
