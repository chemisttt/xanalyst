# === Telegram Monitoring (Telethon userbot) ===
# Получить на https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+7...

# Каналы/чаты для мониторинга (через запятую)
# Можно @username или числовой ID (например -1001234567890)
TELEGRAM_CHANNELS=@channel1,@channel2,-1001234567890

# === Telegram Notifications (бот) ===
# Получить у @BotFather
TELEGRAM_BOT_TOKEN=
# ID канала/группы куда слать уведомления
TELEGRAM_NOTIFY_CHAT_ID=
# ID топика для сводок/дайджестов (NEWS)
TELEGRAM_NOTIFY_TOPIC_ID=
# ID топика для Twitter-алертов (EARLY)
TELEGRAM_EARLY_TOPIC_ID=
# Твой user ID (для admin-команд)
TELEGRAM_ADMIN_ID=

# === Discord ===
# Bot/user token from env. Do not commit real tokens.
DISCORD_USER_TOKEN=
# Channel IDs the client can see. Do not commit real IDs.
DISCORD_CHANNEL_IDS=

# === Twitter (Twikit scraping) ===
TWITTER_USERNAME=
TWITTER_PASSWORD=
TWITTER_EMAIL=

# === AI ===
# Perplexity API (основной, для сводок) — https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
# Claude API (опционально, на будущее)
ANTHROPIC_API_KEY=

# === Alphagate (история юзернеймов Twitter) ===
# Куки из браузерного расширения Alphagate (DevTools → Network → Cookie)
# Протухают периодически, обновлять вручную
ALPHAGATE_COOKIES=extensionSessionId=...; userId=...

# === Database ===
DATABASE_URL=postgresql://xanalyst:password@localhost:5432/xanalyst

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Rate Limits ===
# Макс Twitter-профилей в день
MAX_TWITTER_ANALYSES_PER_DAY=50
# Пауза между запросами к Twitter (секунды)
TWITTER_SCRAPE_DELAY=5
# Cooldown на повторный анализ одного handle (часы)
TWITTER_COOLDOWN_HOURS=24

# === Spec 002 V1.5 — Theme Burst Detector ===
# Forum topic IDs — создать вручную в xanalyst bot, скопировать topic_id'ы.
TELEGRAM_MIRROR_THEME_BURST_TOPIC_ID=
TELEGRAM_MIRROR_THEME_BURST_SHADOW_TOPIC_ID=

# Dry-run: true → shadow topic; false → prod THEME_BURST topic.
# Prod as of 2026-08-05: false
THEME_BURST_DRY_RUN=false

# LLM providers (theme_burst: Gemini-first; digests: Perplexity-first):
GEMINI_API_KEY=
GROQ_API_KEY=

# Thresholds recalibrated 2026-08-05 for quieter discussion volume.
# THEME_BURST_S1_Z_THRESHOLD=1.5
# THEME_BURST_S2_RATIO_THRESHOLD=2.0
# THEME_BURST_COMPOSITE_FIRE=2.0
# THEME_BURST_MIN_MSGS_7D_FOR_Z=60
# THEME_BURST_MIN_SLOTS_7D_FOR_Z=12
# THEME_BURST_COOLDOWN_SEC=5400
# THEME_BURST_KILL_MAX_FIRES_PER_HOUR=10
# THEME_BURST_PER_DAY_BUDGET=15
#
# Source quotes in TG alert (2026-08-07) — last N msgs from 30m window:
# THEME_BURST_ALERT_QUOTE_MSGS=6
# THEME_BURST_ALERT_QUOTE_CHARS=160

# Optional separate topic for caller digest (else Mirror DIGEST topic):
# TELEGRAM_MIRROR_CALLER_DIGEST_TOPIC_ID=

# CatchMint retired — leave unset / do not start service.
# CATCHMINT_HEALTH_CHECK=0
